# Copy to an environment file outside the Git repository or inject these values through systemd/Vault.
# Never commit real credentials or API tokens.
# Development preview only (never production): AUTH_DEV_MODE=true ALLOW_FIRST_ADMIN=true DEV_AUTO_APPROVE_USERS=true
NODE_ENV=production
PORT=8000
PUBLIC_URL=https://hamyar.example.org
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_PARTITIONED=false
# Only change the cookie name when hosting multiple app environments on one origin.
AUTH_COOKIE_NAME=hy_session

# Generate unique 32-byte keys: openssl rand -hex 32
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
OTP_HMAC_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Verified bootstrap administrator; remove from runtime environment after the first admin account is created.
ADMIN_BOOTSTRAP_PHONE=+989121234567

# The adapter must accept POST JSON {"to":"+989...","message":"..."} over HTTPS
# with Authorization: Bearer <token>, and return HTTP 2xx only when accepted.
SMS_GATEWAY_URL=https://sms-adapter.internal.example/api/send
SMS_GATEWAY_TOKEN=REPLACE_ME

# Optional Google OpenID Connect. Register this exact callback URI in Google Cloud Console.
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REDIRECT_URI=https://hamyar.example.org/auth/google/callback

# Optional local language model; the application server talks to this address, never the browser.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Enable only when a trusted reverse proxy strips incoming X-Forwarded-For and sets its own value.
TRUST_PROXY=false
